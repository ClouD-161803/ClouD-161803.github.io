---
// a canvas behind the page on which branching lines grow in from the edges, drawn by growPlum in
// src/lib/plum.ts. it persists across client-side navigation, hence the drawing is made once per
// visit, and it is left blank when the visitor prefers reduced motion
---

<canvas class="plum" aria-hidden="true" transition:persist></canvas>

<script>
  import { growPlum } from '../lib/plum';

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.plum');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (canvas && !reduced.matches) growPlum(canvas);
</script>
