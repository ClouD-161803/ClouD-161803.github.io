---
import { nav } from '../data/nav';
// his monogram, traced from a pen drawing, which writes itself on through the pen sweep inside the
// svg. tools/writeon-tube.js in website-assets/signature/, beside the checkout, generates the file
import Signature from '../assets/signature.svg';

// the icon links stand in a row above the page links, which form one row with a hairline between
// the writing group and the arts group. the about page is reached through the mark at the top left
// and has no link here
const groups = [['/publications/', '/projects/', '/essays/'], ['/photography/', '/art/', '/music/']].map(
  (hrefs) => hrefs.map((href) => nav.find((item) => item.href === href)!),
);

const strip = (pathname: string) => pathname.replace(/\/$/, '') || '/';
const path = strip(Astro.url.pathname);
const isActive = (href: string) => {
  const target = strip(href);
  return target === '/' ? path === '/' : path === target || path.startsWith(`${target}/`);
};

// the glyphs are Remix Icon (github-fill, linkedin-fill, Apache 2.0) and Simple Icons (googlescholar, orcid, CC0)
