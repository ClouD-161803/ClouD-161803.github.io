---

<header class="site-header" transition:name="header" transition:animate="none">
  <a class="site-mark" href="/" aria-label="Claudio Vestini, about">
    <Signature aria-hidden="true" focusable="false" />
  </a>
  <nav class="site-nav" aria-label="Site">
    <ul class="nav-list">
      {
        icons.map(({ label, href, d }) => (
          <li class="nav-icon">
            <a href={href} rel="me" title={label} aria-label={label}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d={d} fill="currentColor" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="nav-list">
      {
        groups.map((group, i) => (
          <>
            {i > 0 && <li class="nav-rule" aria-hidden="true" />}
            {group.map(({ label, href }) => (
              <li>
                <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))}
          </>
        ))
      }
    </ul>
  </nav>
</header>
