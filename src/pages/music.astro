---
import Base from '../layouts/Base.astro';
import SectionNav from '../components/SectionNav.astro';
import data from '../data/playlists.json';

const { profile } = data;
// a playlist with hidden: true stays in the list but off the page
const playlists = data.playlists.filter((playlist) => !('hidden' in playlist && playlist.hidden));
---

<Base title="Music" description="Public Spotify playlists by Claudio Vestini." width="wide">
  <SectionNav current="/music/" />
  <p class="quiet">A collection of my favorite playlists from my <a href={profile}>Spotify profile</a>.</p>
  {
    playlists.length === 0 ? (
      <p class="quiet">Nothing here yet.</p>
    ) : (
      <ul class="playlists">
        {playlists.map((playlist, i) => (
          <li class="slide-enter" style={`--enter-stage:${Math.min(i, 12)}`}>
            <figure class="playlist">
              <figcaption class="playlist-caption">
                <span class="playlist-name">{playlist.name}</span>
                <span class="playlist-meta">
                  {playlist.description && <span>{playlist.description}</span>}
                  <span>{playlist.tracks} tracks</span>
                  <a href={playlist.url} aria-label={`open ${playlist.name} on Spotify`}>
                    open on Spotify
                  </a>
                </span>
              </figcaption>
              <iframe
                class="playlist-embed"
                data-src={`https://open.spotify.com/embed/playlist/${playlist.id}?theme=0`}
                title={`${playlist.name} on Spotify`}
                width="100%"
                height="352"
                frameborder="0"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              />
            </figure>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .playlists {
    display: grid;
    gap: 2.5rem 2rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 48em) {
    .playlists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* the caption sits above the frame, hence the global figcaption top margin is replaced by a bottom one */
  .playlist-caption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0 0 0.75rem;
    font-size: var(--fs-1);
    color: var(--color-subtle);
  }

  .playlist-name {
    font-size: var(--fs-3);
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .playlist-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .playlist-meta a {
    color: var(--color-subtle);
  }

  /* 12 px matches the corner radius of Spotify's own frame */
  .playlist-embed {
    display: block;
    border: 0;
    border-radius: 12px;
    background: var(--color-surface);
  }
</style>

<script>
  // the embeds take their source as they come within 400 px of the viewport, so that a visit
  // does not ask Spotify's edge for thirteen players at once, which it answers with 406 after a
  // burst, and so that the browser's own lazy attribute, which breaks the embed in some browsers,
  // is not needed. bound on every page load, since the client router swaps the page
  function setup() {
    const frames = document.querySelectorAll<HTMLIFrameElement>('iframe[data-src]');
    if (frames.length === 0) return;
    const load = (frame: HTMLIFrameElement) => {
      frame.src = frame.dataset.src!;
      delete frame.dataset.src;
    };
    if (!('IntersectionObserver' in window)) {
      frames.forEach(load);
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          load(entry.target as HTMLIFrameElement);
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '400px 0px' },
    );
    frames.forEach((frame) => observer.observe(frame));
  }
  document.addEventListener('astro:page-load', setup);
</script>
