---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import SectionNav from '../components/SectionNav.astro';
import data from '../data/art.json';

type Post = (typeof data.posts)[number];

const posts = data.posts as Post[];
const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/art/**/*.jpg', {
  eager: true,
});
const asset = (file: string) => assets[`/src/assets/art/${file}`].default;
const sizes =
  '(min-width: 67rem) 20.7rem, (min-width: 52rem) calc((100vw - 5rem) / 3), (min-width: 32rem) calc((100vw - 4rem) / 2), calc(100vw - 3rem)';
// the link holds only the image, hence the alt names the link
const heading = (post: Post) =>
  post.title ? `${post.title}, ${post.artist}, ${post.year}` : post.caption.split('\n')[0];
---

<Base title="Art" description="Photographs of artworks by Claudio Vestini." width="wide">
  <SectionNav current="/art/" />
  <p class="quiet">A selection of artworks I liked enough to photograph.</p>
  {posts.length === 0 && <p class="quiet">Nothing here yet.</p>}
  <ul class="covers">
    {
      posts.map((post, i) => (
        <li class="slide-enter" style={`--enter-stage:${Math.min(i, 12)}`}>
          <a href={`/art/${post.key}/`}>
            <Image
              class="frame cover"
              src={asset(post.images[0].file)}
              alt={heading(post)}
              width={1024}
              widths={[480, 1024]}
              sizes={sizes}
              loading={i < 3 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </a>
          {post.title ? (
            <>
              <span class="cover-title">
                <em>{post.title}</em>, {post.artist}, {post.year}
              </span>
              <span class="cover-year">📍 {post.museum_url ? <a href={post.museum_url}>{post.museum}</a> : post.museum}, {post.maps_url ? <a href={post.maps_url}>{post.city}</a> : post.city}{post.flag && <> <span role="img" aria-label={post.country}>{post.flag}</span></>}{post.exhibition && <> <span class="tag">{post.exhibition}</span></>}</span>
            </>
          ) : (
            <span class="cover-title cover-caption">{post.caption}</span>
          )}
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .covers {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  .covers li > a {
    display: block;
    text-decoration: none;
  }

  .cover {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .cover-title {
    display: block;
    margin-top: 0.75rem;
  }

  .cover-caption {
    margin-bottom: 1rem;
    white-space: pre-line;
  }

  .cover-year {
    display: block;
    margin-bottom: 1rem;
    font-size: var(--fs-1);
    color: var(--color-subtle);
  }

  .covers li:has(> a:hover) .cover-title {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 32rem) {
    .covers {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 52rem) {
    .covers {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
